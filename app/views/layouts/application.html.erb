<!DOCTYPE html>
<html lang="ko">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} | MakeDoc" : "MakeDoc - 해외 의대 전문 컨설팅" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <meta name="description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : "해외 의대 입학부터 졸업, 면허 취득까지 전 과정을 책임지는 전문 컨설팅. 우즈베키스탄, 몽골, 헝가리 의대 공식 입학처." %>">
    <meta name="theme-color" content="#2C4A4E">

    <!-- Open Graph -->
    <meta property="og:title" content="<%= content_for?(:title) ? yield(:title) : "MakeDoc - 해외 의대 전문 컨설팅" %>">
    <meta property="og:description" content="해외 의대 입학부터 졸업, 면허 취득까지 전 과정을 책임지는 전문 컨설팅">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="ko_KR">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Fonts: swap prevents render-blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Noto+Sans+KR:wght@400;500;600;700;900&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Noto+Sans+KR:wght@400;500;600;700;900&display=swap" rel="stylesheet"></noscript>

    <!-- Local Tailwind CSS build (replaces CDN) -->
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <style>
      body {
        font-family: 'Noto Sans KR', 'Sora', sans-serif;
        color: #3D5F63;
        background-color: #FAFBF9;
        letter-spacing: -0.01em;
      }
      h1, h2, h3, h4 {
        font-family: 'Sora', 'Noto Sans KR', sans-serif;
        color: #1C3336;
        letter-spacing: -0.025em;
      }
      .navbar {
        height: 72px;
        transition: box-shadow 300ms ease;
      }
      .scrolled { box-shadow: 0 2px 8px rgba(44, 74, 78, 0.06); }
      .nav-link {
        font-size: 14px; font-weight: 500; color: #1C3336;
        padding: 8px 16px; border-radius: 0.5rem; transition: all 200ms ease;
      }
      .nav-link:hover, .nav-link.active { color: #2C4A4E; background-color: #F0F4F4; }
    </style>

    <%= yield(:head) %>
  </head>

  <body class="antialiased min-h-screen flex flex-col pt-[72px]">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:bg-accent focus:text-accent-foreground focus:px-4 focus:py-2 focus:rounded-md focus:font-semibold">본문 바로가기</a>

    <!-- Navbar -->
    <header class="navbar fixed top-0 w-full bg-white/80 backdrop-blur-md border-b border-border z-50 flex items-center px-4 lg:px-10 justify-between" role="banner">
      <div class="flex items-center">
        <a href="/" class="text-2xl font-extrabold tracking-tight text-primary-dark" aria-label="MakeDoc 홈">MakeDoc</a>
      </div>

      <nav class="hidden md:flex items-center space-x-1" aria-label="메인 내비게이션">
        <a href="/about" class="nav-link <%= 'active' if request.path == '/about' %>">About MakeDoc</a>
        <a href="/medical_schools" class="nav-link <%= 'active' if request.path == '/medical_schools' %>">Medical Schools</a>
        <a href="/news" class="nav-link <%= 'active' if request.path == '/news' %>">News</a>
        <a href="/building" class="nav-link <%= 'active' if request.path == '/building' %>">MAKEDOC Building</a>
        <a href="/reservation" class="nav-link <%= 'active' if request.path == '/reservation' %>">예약상담</a>
        <a href="/reviews" class="nav-link <%= 'active' if request.path == '/reviews' %>">합격후기</a>
        <a href="/directions" class="nav-link <%= 'active' if request.path == '/directions' %>">오시는길</a>
      </nav>

      <div class="hidden md:flex items-center space-x-4">
        <a href="/reservation" class="bg-accent hover:bg-accent-hover text-accent-foreground font-semibold text-sm py-2.5 px-5 rounded-lg transition duration-200 shadow-sm">
          상담 신청 ➜
        </a>
      </div>

      <!-- Mobile Hamburger -->
      <div class="md:hidden">
        <button id="mobile-menu-btn" aria-label="메뉴 열기" aria-expanded="false" aria-controls="mobile-menu" class="p-2 text-text-dark">
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
    </header>

    <!-- Mobile Menu -->
    <nav id="mobile-menu" class="fixed inset-x-0 top-[72px] bg-white border-b border-border-light z-40 hidden md:hidden shadow-lg" aria-label="모바일 내비게이션">
      <div class="flex flex-col px-6 py-4 space-y-1">
        <a href="/about" class="nav-link py-3 border-b border-border-light">About MakeDoc</a>
        <a href="/medical_schools" class="nav-link py-3 border-b border-border-light">Medical Schools</a>
        <a href="/news" class="nav-link py-3 border-b border-border-light">News</a>
        <a href="/building" class="nav-link py-3 border-b border-border-light">MAKEDOC Building</a>
        <a href="/reservation" class="nav-link py-3 border-b border-border-light">예약상담</a>
        <a href="/reviews" class="nav-link py-3 border-b border-border-light">합격후기</a>
        <a href="/directions" class="nav-link py-3">오시는길</a>
        <a href="/reservation" class="bg-accent hover:bg-accent-hover text-accent-foreground font-semibold text-sm py-3 px-6 rounded-lg transition duration-200 text-center mt-3">상담 신청 ➜</a>
      </div>
    </nav>

    <main id="main-content" class="flex-grow" role="main">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="bg-primary-dark text-primary/70 py-16 px-4 lg:px-10 mt-auto" role="contentinfo">
      <div class="container mx-auto max-w-7xl grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
        <div>
          <h2 class="text-2xl font-bold text-white mb-6">MakeDoc</h2>
          <p class="text-sm mb-2">상호: 메이크닥 | 대표: OOO</p>
          <p class="text-sm mb-2">사업자등록번호: 000-00-00000</p>
          <p class="text-sm mb-2">주소: 서울 강남구 봉은사로 129, 1603호</p>
          <p class="text-sm">전화: 1644-5161 / 02-2038-3025</p>
        </div>

        <div>
          <h3 class="text-white text-sm font-bold uppercase tracking-wider mb-4">Discover</h3>
          <ul class="space-y-2">
            <li><a href="/about" class="hover:text-secondary transition duration-200 text-sm">About MakeDoc</a></li>
            <li><a href="/medical_schools" class="hover:text-secondary transition duration-200 text-sm">Medical Schools</a></li>
            <li><a href="/building" class="hover:text-secondary transition duration-200 text-sm">Our Building</a></li>
          </ul>
        </div>

        <div>
          <h3 class="text-white text-sm font-bold uppercase tracking-wider mb-4">Quick Links</h3>
          <ul class="space-y-2">
            <li><a href="/reservation" class="hover:text-secondary transition duration-200 text-sm">상담 예약</a></li>
            <li><a href="/reviews" class="hover:text-secondary transition duration-200 text-sm">합격 후기</a></li>
            <li><a href="/news" class="hover:text-secondary transition duration-200 text-sm">News</a></li>
          </ul>
        </div>

        <div>
          <h3 class="text-white text-sm font-bold uppercase tracking-wider mb-4">Newsletter</h3>
          <form class="flex flex-col sm:flex-row gap-2" action="#" method="post">
            <label for="newsletter-email" class="sr-only">이메일 주소</label>
            <input id="newsletter-email" type="email" placeholder="Your Email" required class="flex-grow bg-white/10 border border-white/20 text-white text-sm px-4 py-2.5 rounded-md focus:outline-none focus:border-accent" autocomplete="email">
            <button type="submit" class="bg-secondary text-secondary-foreground font-semibold px-4 py-2.5 rounded-lg hover:bg-secondary-hover transition duration-200">Subscribe</button>
          </form>
        </div>
      </div>
      <div class="container mx-auto max-w-7xl mt-10 pt-6 border-t border-white/10 flex flex-col md:flex-row justify-between text-xs">
        <p>&copy; 2026 MakeDoc. All rights reserved.</p>
        <div class="space-x-4 mt-4 md:mt-0">
          <a href="#" class="hover:text-white transition duration-200">개인정보처리방침</a>
          <a href="#" class="hover:text-white transition duration-200">이용약관</a>
        </div>
      </div>
    </footer>

    <script>
      window.addEventListener('scroll', () => {
        const nav = document.querySelector('.navbar');
        if(window.scrollY > 10) nav.classList.add('scrolled');
        else nav.classList.remove('scrolled');
      }, {passive: true});

      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('menu-icon-open');
      const iconClose = document.getElementById('menu-icon-close');
      menuBtn.addEventListener('click', () => {
        const isOpen = !mobileMenu.classList.contains('hidden');
        mobileMenu.classList.toggle('hidden');
        iconOpen.classList.toggle('hidden');
        iconClose.classList.toggle('hidden');
        menuBtn.setAttribute('aria-expanded', !isOpen);
        menuBtn.setAttribute('aria-label', isOpen ? '메뉴 열기' : '메뉴 닫기');
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
          mobileMenu.classList.add('hidden');
          iconOpen.classList.remove('hidden');
          iconClose.classList.add('hidden');
          menuBtn.setAttribute('aria-expanded', 'false');
          menuBtn.setAttribute('aria-label', '메뉴 열기');
          menuBtn.focus();
        }
      });
    </script>
  </body>
</html>
