<!DOCTYPE html>
<html lang="ko">
  <head>
    <title>MakeDoc - 해외 의대 전문 컨설팅</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Kakao Maps SDK -->
    <script src="https://dapi.kakao.com/v2/maps/sdk.js?appkey=5983d0df7920fe46249c12b404a00540&libraries=services" defer></script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Noto+Sans+KR:wght@400;500;600;700;900&display=swap" rel="stylesheet">
    
    <%#= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%#= javascript_importmap_tags %>
    <!-- Add Tailwind via CDN for development speed if backend build fails, but we assume local build will work -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary:   { DEFAULT: '#92B9BD', hover: '#7DA5A9', dark: '#2C4A4E', foreground: '#1C3336' },
              secondary: { DEFAULT: '#A8D4AD', hover: '#8FC496', dark: '#1E3322', foreground: '#1E3322' },
              accent:    { DEFAULT: '#E8EC67', hover: '#D4D855', dark: '#3B3D15', foreground: '#2E3010' },
              muted:     { DEFAULT: '#F0F4F4', foreground: '#6B8B8F' },
              lime:      { DEFAULT: '#F2F79E', dark: '#D4D855' },
              bg:        { DEFAULT: '#FAFBF9', light: '#F0F4F4', cream: '#F7FAF0' },
              text:      { dark: '#1C3336', body: '#3D5F63', muted: '#6B8B8F', white: '#FFFFFF' },
              border:    { DEFAULT: '#D5E2E3', light: '#E8EFEF' },
            },
            fontFamily: {
              sans: ['"Noto Sans KR"', 'Sora', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
              heading: ['Sora', '"Noto Sans KR"', 'sans-serif'],
            },
            borderRadius: {
              lg: '0.75rem', xl: '1rem', '2xl': '1.25rem',
            }
          }
        }
      }
    </script>
    <style>
      :root {
        --color-primary: #92B9BD;
        --color-secondary: #A8D4AD;
        --color-accent: #E8EC67;
        --color-lime: #F2F79E;
        --radius: 0.75rem;
      }
      body {
        font-family: 'Noto Sans KR', 'Sora', sans-serif;
        color: #3D5F63;
        background-color: #FAFBF9;
        letter-spacing: -0.01em;
      }
      h1, h2, h3, h4 {
        font-family: 'Sora', 'Noto Sans KR', sans-serif;
        color: #1C3336;
        letter-spacing: -0.025em;
      }
      .navbar {
        height: 72px;
        transition: box-shadow 300ms ease;
      }
      .scrolled { box-shadow: 0 2px 8px rgba(44, 74, 78, 0.06); }
      .nav-link {
        font-size: 14px; font-weight: 500; color: #1C3336;
        padding: 8px 16px; border-radius: 0.5rem; transition: all 200ms ease;
      }
      .nav-link:hover, .nav-link.active { color: #2C4A4E; background-color: #F0F4F4; }
    </style>
  </head>

  <body class="antialiased min-h-screen flex flex-col pt-[72px]">
    <!-- Navbar -->
    <header class="navbar fixed top-0 w-full bg-white/80 backdrop-blur-md border-b border-border z-50 flex items-center px-4 lg:px-10 justify-between">
      <div class="flex items-center">
        <a href="/" class="text-2xl font-extrabold tracking-tight text-primary-dark">MakeDoc</a>
      </div>

      <nav class="hidden md:flex items-center space-x-1">
        <a href="/about" class="nav-link">About MakeDoc</a>
        <a href="/medical_schools" class="nav-link">Medical Schools</a>
        <a href="/news" class="nav-link">News</a>
        <a href="/building" class="nav-link">MAKEDOC Building</a>
        <a href="/reservation" class="nav-link">예약상담</a>
        <a href="/reviews" class="nav-link">합격후기</a>
        <a href="/directions" class="nav-link">오시는길</a>
      </nav>

      <div class="hidden md:flex items-center space-x-4">
        <a href="/reservation" class="bg-accent hover:bg-accent-hover text-accent-foreground font-semibold text-sm py-2.5 px-5 rounded-lg transition duration-200 shadow-sm">
          상담 신청 ➜
        </a>
      </div>

      <!-- Mobile Hamburger -->
      <div class="md:hidden">
        <button id="mobile-menu-btn" aria-label="메뉴 열기" aria-expanded="false" class="p-2 text-text-dark">
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
    </header>

    <!-- Mobile Menu -->
    <nav id="mobile-menu" class="fixed inset-x-0 top-[72px] bg-white border-b border-border-light z-40 hidden md:hidden shadow-lg">
      <div class="flex flex-col px-6 py-4 space-y-1">
        <a href="/about" class="nav-link py-3 border-b border-border-light">About MakeDoc</a>
        <a href="/medical_schools" class="nav-link py-3 border-b border-border-light">Medical Schools</a>
        <a href="/news" class="nav-link py-3 border-b border-border-light">News</a>
        <a href="/building" class="nav-link py-3 border-b border-border-light">MAKEDOC Building</a>
        <a href="/reservation" class="nav-link py-3 border-b border-border-light">예약상담</a>
        <a href="/reviews" class="nav-link py-3 border-b border-border-light">합격후기</a>
        <a href="/directions" class="nav-link py-3">오시는길</a>
        <a href="/reservation" class="bg-accent hover:bg-accent-hover text-accent-foreground font-semibold text-sm py-3 px-6 rounded-lg transition duration-200 text-center mt-3">상담 신청 ➜</a>
      </div>
    </nav>

    <main class="flex-grow">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="bg-primary-dark text-primary/70 py-16 px-4 lg:px-10 mt-auto">
      <div class="container mx-auto max-w-7xl grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
        <div>
          <h2 class="text-2xl font-bold text-white mb-6">MakeDoc</h2>
          <p class="text-sm mb-2">상호: 메이크닥 | 대표: OOO</p>
          <p class="text-sm mb-2">사업자등록번호: 000-00-00000</p>
          <p class="text-sm mb-2">주소: 서울 강남구 봉은사로 129, 1603호</p>
          <p class="text-sm">전화: 1644-5161 / 02-2038-3025</p>
        </div>
        
        <div>
          <h3 class="text-white text-sm font-bold uppercase tracking-wider mb-4">Discover</h3>
          <ul class="space-y-2">
            <li><a href="/about" class="hover:text-secondary transition duration-200 text-sm">About MakeDoc</a></li>
            <li><a href="/medical_schools" class="hover:text-secondary transition duration-200 text-sm">Medical Schools</a></li>
            <li><a href="/building" class="hover:text-secondary transition duration-200 text-sm">Our Building</a></li>
          </ul>
        </div>

        <div>
          <h3 class="text-white text-sm font-bold uppercase tracking-wider mb-4">Quick Links</h3>
          <ul class="space-y-2">
            <li><a href="/reservation" class="hover:text-secondary transition duration-200 text-sm">상담 예약</a></li>
            <li><a href="/reviews" class="hover:text-secondary transition duration-200 text-sm">합격 후기</a></li>
            <li><a href="/news" class="hover:text-secondary transition duration-200 text-sm">News</a></li>
          </ul>
        </div>

        <div>
          <h3 class="text-white text-sm font-bold uppercase tracking-wider mb-4">Newsletter</h3>
          <div class="flex flex-col sm:flex-row gap-2">
            <input type="email" placeholder="Your Email" class="flex-grow bg-white/10 border border-white/20 text-white text-sm px-4 py-2.5 rounded-md focus:outline-none focus:border-accent">
            <button class="bg-secondary text-secondary-foreground font-semibold px-4 py-2.5 rounded-lg hover:bg-secondary-hover transition duration-200">Subscribe</button>
          </div>
        </div>
      </div>
      <div class="container mx-auto max-w-7xl mt-10 pt-6 border-t border-white/10 flex flex-col md:flex-row justify-between text-xs">
        <p>© 2026 MakeDoc. All rights reserved.</p>
        <div class="space-x-4 mt-4 md:mt-0">
          <a href="#" class="hover:text-white transition duration-200">개인정보처리방침</a>
          <a href="#" class="hover:text-white transition duration-200">이용약관</a>
        </div>
      </div>
    </footer>

    <script>
      window.addEventListener('scroll', () => {
        const nav = document.querySelector('.navbar');
        if(window.scrollY > 10) nav.classList.add('scrolled');
        else nav.classList.remove('scrolled');
      });

      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('menu-icon-open');
      const iconClose = document.getElementById('menu-icon-close');
      menuBtn.addEventListener('click', () => {
        const isOpen = !mobileMenu.classList.contains('hidden');
        mobileMenu.classList.toggle('hidden');
        iconOpen.classList.toggle('hidden');
        iconClose.classList.toggle('hidden');
        menuBtn.setAttribute('aria-expanded', !isOpen);
      });
    </script>
  </body>
</html>
