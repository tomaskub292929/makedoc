<% content_for :title, "무료 상담 예약" %>
<% content_for :meta_description, "메이크닥 전문 컨설턴트와 무료 상담을 예약하세요. 헝가리, 몽골, 미국 의대 과정에 대한 맞춤 입시 상담을 받으실 수 있습니다." %>

<% content_for :head do %>
<style>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes pulse-gold {
    0%, 100% { box-shadow: 0 0 0 0 rgba(232, 168, 56, 0.4); }
    50% { box-shadow: 0 0 0 8px rgba(232, 168, 56, 0); }
  }
  @keyframes countUp {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .fade-in-up { animation: fadeInUp 0.7s ease-out both; }
  .fade-in-up-delay-1 { animation: fadeInUp 0.7s ease-out 0.15s both; }
  .fade-in-up-delay-2 { animation: fadeInUp 0.7s ease-out 0.3s both; }
  .fade-in-up-delay-3 { animation: fadeInUp 0.7s ease-out 0.45s both; }
  .pulse-gold { animation: pulse-gold 2s ease-in-out infinite; }
  .count-up { animation: countUp 0.5s ease-out both; }

  .testimonial-track {
    display: flex;
    transition: transform 0.5s ease-in-out;
  }
  .testimonial-slide {
    min-width: 100%;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
  }
</style>
<% end %>

<!-- 1. Hero Section -->
<section class="relative bg-primary-dark overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-primary-dark via-primary to-primary-dark opacity-90"></div>
  <div class="absolute inset-0" style="background-image: url('https://images.unsplash.com/photo-1576091160550-2173dba999ef?w=1920&q=80'); background-size: cover; background-position: center; opacity: 0.15;"></div>

  <div class="relative container mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div class="max-w-2xl mx-auto text-center">
      <p class="text-accent font-semibold text-sm tracking-wider uppercase mb-4 fade-in-up">Free 1:1 Consultation</p>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight mb-6 fade-in-up-delay-1">
        의사의 꿈, 첫 걸음은<br class="hidden md:block"> 상담에서 시작됩니다
      </h1>
      <p class="text-white/70 text-lg mb-8 fade-in-up-delay-2">
        무료 1:1 전문 컨설팅으로 나만의 입학 로드맵을 받아보세요
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 text-white/80 text-sm mb-10 fade-in-up-delay-3">
        <span class="flex items-center gap-2">
          <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          10분 내 컨설턴트 배정
        </span>
        <span class="flex items-center gap-2">
          <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          개인 맞춤 입학 전략 수립
        </span>
        <span class="flex items-center gap-2">
          <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          합격 가능성 무료 진단
        </span>
      </div>

      <a href="#reservation-form" class="inline-flex items-center gap-2 bg-accent hover:bg-accent-hover text-white font-bold text-lg py-4 px-10 rounded-lg transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg pulse-gold fade-in-up-delay-3">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
        지금 무료 상담 신청하기
      </a>
    </div>
  </div>
</section>

<!-- 2. Trust Badge Bar -->
<section class="bg-white border-b border-border py-6">
  <div class="container mx-auto max-w-5xl px-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div class="count-up">
        <p class="text-2xl md:text-3xl font-bold text-primary" data-count="350">350+</p>
        <p class="text-xs text-text-muted mt-1">합격생 배출</p>
      </div>
      <div class="count-up" style="animation-delay: 0.1s;">
        <p class="text-2xl md:text-3xl font-bold text-primary">96.5<span class="text-lg">%</span></p>
        <p class="text-xs text-text-muted mt-1">합격률</p>
      </div>
      <div class="count-up" style="animation-delay: 0.2s;">
        <p class="text-2xl md:text-3xl font-bold text-primary">12</p>
        <p class="text-xs text-text-muted mt-1">파트너 대학</p>
      </div>
      <div class="count-up" style="animation-delay: 0.3s;">
        <p class="text-2xl md:text-3xl font-bold text-primary flex items-center justify-center gap-1">
          4.9
          <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        </p>
        <p class="text-xs text-text-muted mt-1">상담 만족도</p>
      </div>
    </div>
  </div>
</section>

<!-- 3. Urgency Banner -->
<section class="bg-accent-light border-b border-accent/20 py-3">
  <div class="container mx-auto max-w-5xl px-6 flex flex-col sm:flex-row items-center justify-center gap-2 text-sm">
    <span class="flex items-center gap-2 font-semibold text-primary-dark">
      <svg class="w-4 h-4 text-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
      2025년 상반기 입학 상담 마감 임박
    </span>
    <span class="text-text-body">|</span>
    <span class="text-text-body">현재 <strong class="text-primary">이번 주 상담 가능 잔여석 3자리</strong></span>
  </div>
</section>

<!-- 4. Main Content: 2-Column Layout (Form + Side Info) -->
<section id="reservation-form" class="py-16 md:py-20 bg-bg-light px-6">
  <div class="container mx-auto max-w-6xl">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10">

      <!-- Left: Form (3 cols) -->
      <div class="lg:col-span-3">
        <div class="bg-white border border-border p-8 md:p-10 rounded-2xl shadow-card">
          <div class="mb-8">
            <h2 class="text-2xl font-bold text-text-dark">무료 1:1 맞춤 컨설팅 신청</h2>
            <p class="text-text-body mt-2 text-sm">간단한 정보를 남겨주시면, 전문 컨설턴트가 빠르게 연락드립니다.</p>
          </div>

          <form id="consultation-form" class="space-y-5">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div class="flex flex-col gap-1.5">
                <label for="reservation-name" class="text-sm font-semibold text-text-dark">이름 <span class="text-semantic-error" aria-label="필수">*</span></label>
                <input id="reservation-name" type="text" required class="w-full px-4 py-3 bg-white border border-border rounded-lg focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all text-text-dark" placeholder="홍길동" autocomplete="name">
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="reservation-phone" class="text-sm font-semibold text-text-dark">연락처 <span class="text-semantic-error" aria-label="필수">*</span></label>
                <input id="reservation-phone" type="tel" required class="w-full px-4 py-3 bg-white border border-border rounded-lg focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all text-text-dark" placeholder="010-0000-0000" autocomplete="tel">
              </div>
            </div>
              <div class="flex flex-col gap-1.5">
                <label for="reservation-email" class="text-sm font-semibold text-text-dark">이메일</label>
                <input id="reservation-email" type="email" class="w-full px-4 py-3 bg-white border border-border rounded-lg focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all text-text-dark" placeholder="example@email.com" autocomplete="email">
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div class="flex flex-col gap-1.5">
                  <label for="reservation-date" class="text-sm font-semibold text-text-dark">희망 상담일시</label>
                  <input id="reservation-date" type="date" class="w-full px-4 py-3 bg-white border border-border rounded-lg focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all text-text-dark">
                </div>
                <div class="flex flex-col gap-1.5">
                  <label for="reservation-time" class="text-sm font-semibold text-text-dark">희망 시간대</label>
                  <select id="reservation-time" class="w-full px-4 py-3 bg-white border border-border rounded-lg focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all text-text-dark">
                    <option value="">선택하세요</option>
                    <option value="morning">오전 (09:00~12:00)</option>
                    <option value="afternoon">오후 (13:00~17:00)</option>
                    <option value="evening">저녁 (18:00~20:00)</option>
                  </select>
                </div>
              </div>

              <div class="flex flex-col gap-1.5">
                <label for="reservation-course" class="text-sm font-semibold text-text-dark">관심 과정 <span class="text-semantic-error" aria-label="필수">*</span></label>
                <select id="reservation-course" class="w-full px-4 py-3 bg-white border border-border rounded-lg focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all text-text-dark">
                  <option value="">선택하세요</option>
                  <option value="mongolia">몽골 의대 과정</option>
                  <option value="hungary">헝가리 의대 과정</option>
                  <option value="usa">미국 의대 과정</option>
                  <option value="other">기타</option>
                </select>
              </div>

              <!-- Consultation Method -->
              <div class="flex flex-col gap-2">
                <label class="text-sm font-semibold text-text-dark">희망 상담 방식</label>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                  <label class="flex items-center gap-2 px-4 py-3 border border-border rounded-lg cursor-pointer hover:border-primary hover:bg-primary/5 transition-all has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                    <input type="radio" name="consultation-method" value="phone" class="w-4 h-4 text-primary focus:ring-primary">
                    <span class="text-sm text-text-dark">전화</span>
                  </label>
                  <label class="flex items-center gap-2 px-4 py-3 border border-border rounded-lg cursor-pointer hover:border-primary hover:bg-primary/5 transition-all has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                    <input type="radio" name="consultation-method" value="visit" class="w-4 h-4 text-primary focus:ring-primary">
                    <span class="text-sm text-text-dark">대면</span>
                  </label>
                  <label class="flex items-center gap-2 px-4 py-3 border border-border rounded-lg cursor-pointer hover:border-primary hover:bg-primary/5 transition-all has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                    <input type="radio" name="consultation-method" value="video" class="w-4 h-4 text-primary focus:ring-primary">
                    <span class="text-sm text-text-dark">화상</span>
                  </label>
                  <label class="flex items-center gap-2 px-4 py-3 border border-border rounded-lg cursor-pointer hover:border-primary hover:bg-primary/5 transition-all has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                    <input type="radio" name="consultation-method" value="kakao" class="w-4 h-4 text-primary focus:ring-primary">
                    <span class="text-sm text-text-dark">카카오톡</span>
                  </label>
                </div>
              </div>

            <div class="flex flex-col gap-1.5">
              <label for="reservation-message" class="text-sm font-semibold text-text-dark">문의 내용</label>
              <textarea id="reservation-message" rows="4" class="w-full px-4 py-3 bg-white border border-border rounded-lg focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/10 transition-all text-text-dark leading-relaxed" placeholder="궁금하신 내용을 자세히 적어주세요"></textarea>
            </div>

            <!-- Privacy -->
            <div class="flex items-start gap-3 p-4 bg-bg-light rounded-lg">
              <input type="checkbox" id="privacy" required class="mt-1 w-4 h-4 text-primary focus:ring-primary border-gray-300 rounded">
              <label for="privacy" class="text-sm text-text-body">
                <strong>[필수]</strong> 개인정보 수집 및 이용에 동의합니다. (수집 항목: 이름, 연락처 등)
              </label>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="w-full bg-accent hover:bg-accent-hover text-white font-bold text-lg py-4 rounded-lg transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg pulse-gold flex items-center justify-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              무료 맞춤 상담 받기
            </button>
          </form>
        </div>
      </div>

      <!-- Right: Side Info (2 cols) -->
      <div class="lg:col-span-2 space-y-6">

        <!-- What you get -->
        <div class="bg-white border border-border rounded-2xl p-6 shadow-card">
          <h3 class="text-lg font-bold text-text-dark mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6 2a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V7.414A2 2 0 0015.414 6L12 2.586A2 2 0 0010.586 2H6zm2 10a1 1 0 10-2 0 1 1 0 002 0zm4-1a1 1 0 110 2 1 1 0 010-2zm-2-3a1 1 0 10-2 0 1 1 0 002 0z" clip-rule="evenodd"/></svg>
            상담 후 받으실 자료
          </h3>
          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-sm text-text-body">
              <svg class="w-5 h-5 text-semantic-success flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              나에게 맞는 맞춤 입학 로드맵
            </li>
            <li class="flex items-start gap-3 text-sm text-text-body">
              <svg class="w-5 h-5 text-semantic-success flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              국가별 예상 비용 안내서
            </li>
            <li class="flex items-start gap-3 text-sm text-text-body">
              <svg class="w-5 h-5 text-semantic-success flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              최근 합격 사례집
            </li>
            <li class="flex items-start gap-3 text-sm text-text-body">
              <svg class="w-5 h-5 text-semantic-success flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              합격 가능성 진단 리포트
            </li>
          </ul>
        </div>

        <!-- Response time -->
        <div class="bg-primary/5 border border-primary/10 rounded-2xl p-6">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
            </div>
            <div>
              <p class="text-sm font-bold text-text-dark">평균 응답 시간</p>
              <p class="text-xs text-text-muted">영업일 기준</p>
            </div>
          </div>
          <p class="text-3xl font-bold text-primary">1시간 <span class="text-lg font-normal text-text-muted">이내</span></p>
        </div>

        <!-- Consultant card -->
        <div class="bg-white border border-border rounded-2xl p-6 shadow-card">
          <h3 class="text-lg font-bold text-text-dark mb-4">담당 컨설턴트</h3>
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center">
              <svg class="w-7 h-7 text-primary" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/></svg>
            </div>
            <div>
              <p class="font-semibold text-text-dark">MakeDoc 수석 컨설턴트</p>
              <p class="text-xs text-text-muted">해외 의대 입시 전문 10년+</p>
            </div>
          </div>
          <div class="mt-4 pt-4 border-t border-border-light">
            <p class="text-xs text-text-muted italic">"입학부터 졸업, 면허 취득까지 전 과정을 함께하겠습니다. 부담 없이 연락 주세요."</p>
          </div>
        </div>

        <!-- Quick contact -->
        <div class="bg-white border border-border rounded-2xl p-6 shadow-card">
          <h3 class="text-sm font-bold text-text-dark mb-3">빠른 상담 연결</h3>
          <div class="space-y-3">
            <a href="tel:1644-5161" class="flex items-center gap-3 px-4 py-3 bg-bg-light rounded-lg hover:bg-border-light transition-all group">
              <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
              <div>
                <p class="text-sm font-semibold text-text-dark group-hover:text-primary transition-colors">1644-5161</p>
                <p class="text-xs text-text-muted">전화 상담 (평일 09:00~18:00)</p>
              </div>
            </a>
            <a href="#" class="flex items-center gap-3 px-4 py-3 bg-[#FEE500]/10 rounded-lg hover:bg-[#FEE500]/20 transition-all group">
              <svg class="w-5 h-5 text-[#3C1E1E]" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3C6.48 3 2 6.58 2 10.94c0 2.8 1.86 5.27 4.66 6.67-.15.53-.54 1.93-.62 2.23-.1.37.14.37.29.27.12-.08 1.9-1.29 2.66-1.81.65.1 1.32.15 2.01.15 5.52 0 10-3.58 10-7.94S17.52 3 12 3z"/></svg>
              <div>
                <p class="text-sm font-semibold text-text-dark group-hover:text-[#3C1E1E] transition-colors">카카오톡 상담</p>
                <p class="text-xs text-text-muted">실시간 채팅 상담</p>
              </div>
            </a>
          </div>
        </div>

      </div>
    </div>
