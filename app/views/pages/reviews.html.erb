<% content_for :title, "합격 후기 - 학생 합격 스토리" %>
<% content_for :meta_description, "메이크닥과 함께 해외 의대에 합격한 학생들의 생생한 후기와 합격 스토리. 누적 합격자 350명 이상, 최근 3년 합격률 92%." %>

<div class="bg-bg-light pt-20 pb-24 min-h-[80vh]">
  <div class="container mx-auto px-4 max-w-5xl">

    <!-- Header -->
    <div class="text-center mb-16">
      <h1 class="text-4xl font-black text-primary mb-4">합격 후기</h1>
      <p class="text-lg text-text-body max-w-2xl mx-auto">메이크닥과 함께 치열하게 준비하여 꿈을 이룬 학생들의 생생한 합격 스토리입니다.</p>
    </div>

    <!-- Quick Stats Bar -->
    <div class="bg-white rounded-2xl shadow-sm border border-border-light p-6 md:p-8 mb-12 flex flex-col md:flex-row divide-y md:divide-y-0 md:divide-x divide-border-light text-center">
      <div class="flex-1 py-4 md:py-0">
        <p class="text-text-muted text-sm font-semibold uppercase tracking-wider mb-1">누적 합격자</p>
        <p class="text-3xl font-extrabold text-primary">350<span class="text-xl text-primary/70 ml-1">명+</span></p>
      </div>
      <div class="flex-1 py-4 md:py-0">
        <p class="text-text-muted text-sm font-semibold uppercase tracking-wider mb-1">진학 대학 수</p>
        <p class="text-3xl font-extrabold text-primary">12<span class="text-xl text-primary/70 ml-1">개교</span></p>
      </div>
      <div class="flex-1 py-4 md:py-0">
        <p class="text-text-muted text-sm font-semibold uppercase tracking-wider mb-1">합격률 (최근 3년)</p>
        <p class="text-3xl font-extrabold text-primary">92<span class="text-xl text-primary/70 ml-1">%</span></p>
      </div>
    </div>

    <!-- Filter & Auth Controls -->
    <div class="flex flex-wrap justify-between items-center mb-6 gap-4">
      <div class="flex gap-2">
        <label for="reviews-country-filter" class="sr-only">국가별 필터</label>
        <select id="reviews-country-filter" class="form-select bg-white border border-border shadow-sm px-4 py-2 rounded-lg text-sm font-medium focus:ring-primary focus:border-primary">
          <option>국가 전체</option>
          <option>헝가리</option>
          <option>몽골</option>
          <option>미국/기타</option>
        </select>
      </div>
      <div class="flex items-center space-x-3">
        <div class="relative">
          <label for="reviews-search" class="sr-only">이름 또는 학교 검색</label>
          <input id="reviews-search" type="text" placeholder="이름/학교 검색..." class="w-full md:w-64 pl-4 pr-10 py-2 border border-border rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 bg-white shadow-sm">
          <button class="absolute right-3 top-1/2 transform -translate-y-1/2 text-text-muted hover:text-primary" aria-label="검색">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </button>
        </div>
      </div>
    </div>

