      </div>
    </div>

    <!-- Action Bar & Pagination -->
    <div class="mt-8 flex justify-between items-center">
      <div class="hidden md:block w-24"></div>

      <!-- Pagination -->
      <nav class="flex items-center space-x-2 w-full md:w-auto justify-center" aria-label="페이지 내비게이션">
        <a href="#" class="p-2 border border-border bg-white rounded-md text-text-muted hover:bg-bg-light hover:text-primary transition" aria-label="이전 페이지">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        </a>
        <a href="#" class="w-9 h-9 flex items-center justify-center bg-primary text-white rounded-md font-bold text-sm" aria-current="page">1</a>
        <a href="#" class="w-9 h-9 flex items-center justify-center bg-white border border-border rounded-md hover:bg-bg-light text-text-dark text-sm font-medium">2</a>
        <a href="#" class="w-9 h-9 flex items-center justify-center bg-white border border-border rounded-md hover:bg-bg-light text-text-dark text-sm font-medium">3</a>
        <a href="#" class="p-2 border border-border bg-white rounded-md text-text-muted hover:bg-bg-light hover:text-primary transition" aria-label="다음 페이지">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </a>
      </nav>

      <!-- Write Btn -->
