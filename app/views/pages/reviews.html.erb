        <button class="px-5 py-2 bg-text-dark text-white rounded-lg text-sm font-bold shadow-md hover:bg-black transition-colors focus:ring-2 focus:ring-offset-2 focus:ring-text-dark">
          글쓰기
        </button>
      </div>
    </div>

  </div>
</div>
