      <div class="hidden md:grid grid-cols-12 gap-4 p-4 bg-bg-light border-b border-border text-sm font-bold text-text-muted uppercase tracking-wide" role="row" aria-hidden="true">
        <div class="col-span-1 text-center">No</div>
        <div class="col-span-2 text-center">국가/학교</div>
        <div class="col-span-6">제목</div>
        <div class="col-span-2 text-center">작성자</div>
        <div class="col-span-1 text-center">조회</div>
