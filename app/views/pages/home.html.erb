<!-- News Post Feed (네이버 블로그 RSS 연동) -->
<section class="bg-white py-14 md:py-16 px-6">
  <div class="max-w-5xl mx-auto">
    <h2 class="font-heading text-xl md:text-2xl font-extrabold text-center mb-10 tracking-tight" style="color: #6B4B3E;">News</h2>

    <% if @blog_posts.present? %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
        <% @blog_posts.each do |post| %>
          <a href="<%= post[:link] %>" target="_blank" rel="noopener" class="flex justify-between items-start gap-4 cursor-pointer group">
            <div class="flex-1">
              <p class="text-[12px] font-bold text-[#22C55E] mb-1.5"><%= post[:category] %></p>
              <h3 class="text-[16px] font-bold text-text-dark mb-2 leading-tight group-hover:underline decoration-border-dark underline-offset-4"><%= post[:title] %></h3>
              <p class="text-[13px] text-text-body line-clamp-2 leading-relaxed mb-3"><%= post[:description] %></p>
              <div class="text-[11px] text-muted-foreground flex flex-col gap-0.5">
                <span><%= post[:date]&.strftime("%Y-%m-%d %H:%M") %></span>
                <span><%= post[:author] %></span>
              </div>
            </div>
            <% if post[:thumbnail].present? %>
              <div class="w-[90px] h-[90px] flex-shrink-0 rounded-md overflow-hidden bg-gray-100 border border-black/5 mt-1">
                <img src="<%= post[:thumbnail] %>" alt="thumbnail" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy">
              </div>
            <% end %>
          </a>
        <% end %>
      </div>
    <% else %>
      <p class="text-center text-muted-foreground text-sm">블로그 글을 불러오는 중입니다...</p>
    <% end %>
  </div>
</section>

